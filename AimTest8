-- ============= CORE LOGIC (WITH LINGER) =============
local function isAlive(player)
    if not player.Character then return false end
    local hum = player.Character:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function isTeammate(player)
    if not Settings.TeamCheck then return false end
    if player.Team and LocalPlayer.Team then
        return player.Team == LocalPlayer.Team
    end
    return false
end

local function getHitPart(character)
    local part = character:FindFirstChild(Settings.HitPart)
    if not part then
        part = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Head")
        debugPrint("Fallback hit part: " .. (part and part.Name or "none"))
    end
    return part
end

local function isVisible(targetPart)
    if not targetPart then return false end
    local origin = Cam.CFrame.Position
    local direction = (targetPart.Position - origin).Unit
    local distance = (targetPart.Position - origin).Magnitude - 0.1
    if distance <= 0 then return true end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character, targetPart.Parent}
    local result = workspace:Raycast(origin, direction * distance, rayParams)
    return result == nil
end

local function getClosestEnemyInFOV()
    local screenCenter = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
    local closestDist = Settings.FOVRadius
    local closestEnemy = nil

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isAlive(player) and not isTeammate(player) then
            local targetPart = getHitPart(player.Character)
            if targetPart then
                local screenPos, onScreen = Cam:WorldToScreenPoint(targetPart.Position)
                if onScreen then
                    local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                    if screenDist <= closestDist then
                        if Settings.VisibilityCheck and not isVisible(targetPart) then
                            -- skip
                        else
                            closestDist = screenDist
                            closestEnemy = {Player = player, Part = targetPart}
                        end
                    end
                end
            end
        end
    end
    return closestEnemy
end

local function updateJitter()
    if Settings.JitterEnabled and Settings.JitterStrength > 0 then
        local deg = (math.random() - 0.5) * 2 * Settings.JitterStrength
        JitterAngle = math.rad(deg)
    else
        JitterAngle = 0
    end
end

-- Main camlock loop
RunService.Heartbeat:Connect(function(deltaTime)
    lastJitterUpdate = lastJitterUpdate + deltaTime
    if lastJitterUpdate >= jitterInterval then
        updateJitter()
        lastJitterUpdate = 0
    end

    if not Settings.Enabled then
        Target = nil
        return
    end

    -- Check if current target is still valid (alive, visible, not teammate)
    if Target then
        local player = Target.Player
        local part = getHitPart(player.Character)
        if not part or not isAlive(player) or isTeammate(player) or (Settings.VisibilityCheck and not isVisible(part)) then
            Target = nil
            targetLostAt = nil
        else
            -- Target still valid; check if inside FOV
            local screenPos, onScreen = Cam:WorldToScreenPoint(part.Position)
            local screenCenter = Vector2.new(Cam.ViewportSize.X/2, Cam.ViewportSize.Y/2)
            local dist = onScreen and (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude or math.huge
            if dist <= Settings.FOVRadius then
                -- Inside FOV, reset lost timer
                targetLostAt = nil
            else
                -- Outside FOV; start/continue linger timer
                if not targetLostAt then
                    targetLostAt = os.clock()
                    debugPrint("Target left FOV, linger started")
                end
            end
        end
    end

    -- If we have a lingering target, check if linger time expired
    if Target and targetLostAt then
        if os.clock() - targetLostAt > Settings.LingerTime then
            debugPrint("Linger expired, releasing target")
            Target = nil
            targetLostAt = nil
        end
    end

    -- If no current target (or target expired), look for a new one
    if not Target then
        local enemy = getClosestEnemyInFOV()
        if enemy then
            Target = enemy
            targetLostAt = nil
            debugPrint("New target locked: " .. enemy.Player.Name)
        end
    end

    -- If still no target, skip aiming
    if not Target then return end

    -- Apply prediction
    local targetPart = getHitPart(Target.Player.Character)
    if not targetPart then return end
    local targetPos = targetPart.Position
    local targetVelocity = targetPart.Velocity or Vector3.zero
    targetPos = targetPos + targetVelocity * Settings.PredictionTime

    -- World‑space aim
    local desiredLook = (targetPos - Cam.CFrame.Position).Unit
    if JitterAngle ~= 0 then
        local axis = Vector3.new(0, 1, 0)
        local rotation = CFrame.fromAxisAngle(axis, JitterAngle)
        desiredLook = rotation * desiredLook
    end

    local currentLook = Cam.CFrame.LookVector
    local newLook = currentLook:Lerp(desiredLook, Settings.LockStrength).Unit
    Cam.CFrame = CFrame.new(Cam.CFrame.Position, Cam.CFrame.Position + newLook)
end)

LocalPlayer.CharacterAdded:Connect(function(character)
    debugPrint("Character respawned; resetting lock")
    Target = nil
    targetLostAt = nil
end)

debugPrint("Camlock ready — DPad Left to toggle, ⚙ to hide menu. Linger: " .. Settings.LingerTime .. "s")
